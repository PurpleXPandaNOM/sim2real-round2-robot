    Serial.print(y_cm, 2); Serial.print(",");
    Serial.print(theta_rad * 180.0f / PI, 2); Serial.print(",");
    Serial.print(current_ticks_L); Serial.print(",");
    Serial.println(current_ticks_R);
  }
}

