// Non-blocking countdown with LED blinking (cancellable via Serial 'x' OR physical BOOT button)
bool runHandsOffCountdown(uint32_t duration_ms, const char *label) {
  setMotors(0, 0);
  Serial.print("\n[COUNTDOWN]: ");
  Serial.print(label);
  Serial.print(" in ");
  Serial.print(duration_ms / 1000);
  Serial.println(" seconds (Hands off! Tap BOOT or 'x' to cancel)...");

  const uint32_t start_ms = millis();
  uint32_t last_blink_ms = start_ms;
  bool led_state = true;
  bool button_released_since_start = false;
  digitalWrite(LED_PIN, HIGH);

  while (static_cast<uint32_t>(millis() - start_ms) < duration_ms) {
    const uint32_t elapsed_ms = static_cast<uint32_t>(millis() - start_ms);
    if (elapsed_ms > 350) {
      if (digitalRead(BTN_PIN) == HIGH) {
        button_released_since_start = true;
      } else if (button_released_since_start && digitalRead(BTN_PIN) == LOW) {
        digitalWrite(LED_PIN, LOW);
        while (digitalRead(BTN_PIN) == LOW) delay(10);
        last_btn_state = HIGH;
        Serial.println("\n[COUNTDOWN CANCELLED BY BUTTON]");
        return false;
      }
    }

    if (Serial.available() > 0) {
      const char c = static_cast<char>(Serial.peek());
      if (c == 'x' || c == 'X') {
        Serial.read();
        digitalWrite(LED_PIN, LOW);
        last_btn_state = digitalRead(BTN_PIN);
        Serial.println("\n[COUNTDOWN CANCELLED]");
        return false;
      }
    }

    const uint32_t now_ms = millis();
    if (now_ms - last_blink_ms >= 250) {
      last_blink_ms = now_ms;
      led_state = !led_state;
      digitalWrite(LED_PIN, led_state ? HIGH : LOW);
    }
    delay(10);
  }
  digitalWrite(LED_PIN, LOW);
  last_btn_state = digitalRead(BTN_PIN);
  return true;
}

// Determines which waypoint was actually missed (solves post-2.5s dwell increment & final-leg recovery)
int detectMissedWaypointIndex() {
  if (in_dwell_phase) {
    return constrain(current_target_index, 0, 5);
  }
  if (last_dwelled_index >= 0 && last_dwelled_index <= 5) {
    const uint32_t since_dwell_ms = static_cast<uint32_t>(millis() - last_dwell_end_ms);
    const float dist_from_last_dwell = hypotf(x_cm - last_dwell_pos.x, y_cm - last_dwell_pos.y);
    // If stopped within 8s and <25cm of leaving the previous dwell, user is reacting to that missed waypoint
    if (since_dwell_ms < 8000 && dist_from_last_dwell < 25.0f) {
      return last_dwelled_index;
    }
  }
  return constrain(current_target_index, 0, 5);
}

void triggerMissionStart() {
  if (mission_started && !mission_done && !paused_for_recovery) {
    Serial.println("\n[COMMAND IGNORED]: Mission is already active.");
    return;
  }
  if (!gyro_calibrated) {
    Serial.println("\n[WARNING]: Gyro was not cleanly calibrated. Running calibration now...");
    if (!calibrateGyro()) {
      Serial.println("[START ABORTED]: Keep robot stationary and run 'cal' before starting.");
      return;
    }
  }

  if (!runHandsOffCountdown(START_COUNTDOWN_MS, "Starting Mission from Origin (0,0,0)")) {
    return;
  }

  // Wipe any pose drift from handling the robot prior to start
  x_cm = 0.0f;
  y_cm = 0.0f;
  theta_rad = 0.0f;
  current_target_index = 0;
  last_dwelled_index = -1;
  in_dwell_phase = false;
  mission_started = true;
  mission_done = false;
  paused_for_recovery = false;
  pending_recovery_heading_deg = 0.0f;
  abort_current_motion = false;
  syncOdometryTrackers(true);
  Serial.println("\n[MISSION STARTED]: Pose zeroed to (0.0, 0.0, 0.0 deg).");
}

// Step 1 of Recovery: Freezes motors, preserves leg & heading arguments, and waits for human placement
void enterRecoveryPause(int override_route_step, float custom_heading_deg) {
  setMotors(0, 0);
  digitalWrite(LED_PIN, LOW);
  abort_current_motion = true;
  paused_for_recovery = true;
  recovery_blink_start_ms = millis();

  if (override_route_step >= 0 && override_route_step <= 5) {
    recovery_target_index = override_route_step;
  } else {
    recovery_target_index = detectMissedWaypointIndex();
  }
  pending_recovery_heading_deg = isfinite(custom_heading_deg) ? custom_heading_deg : 0.0f;

  Serial.println("\n=======================================================");
  Serial.println("[PAUSED FOR RECOVERY / STOP]: Motors locked OFF.");
  if (recovery_target_index < 5) {
    const Point wp = waypoints[optimal_route[recovery_target_index]];
    Serial.print("Target to Recover: Route Leg ");
    Serial.print(recovery_target_index + 1);
    Serial.print("/5 (Waypoint P");
    Serial.print(optimal_route[recovery_target_index] + 1);
    Serial.print(" at X=");
    Serial.print(wp.x, 1);
    Serial.print(", Y=");
    Serial.print(wp.y, 1);
    Serial.print(") | Saved Heading = ");
    Serial.print(pending_recovery_heading_deg, 1);
    Serial.println(" deg");
  } else {
    Serial.print("Target to Recover: HOME (0, 0) | Saved Heading = ");
    Serial.print(pending_recovery_heading_deg, 1);
    Serial.println(" deg");
  }
  Serial.println("1. Pick up robot & place on missed waypoint at saved heading.");
  Serial.println("2. Short-tap BOOT button (or send 'r') for 5s resume countdown.");
  Serial.println("   (Optional: Hold BOOT >= 0.8s while paused to cycle target leg).");
  Serial.println("=======================================================");
}

// Step 2 of Recovery: 5s hands-off countdown, applies preserved or overridden leg/heading, and resumes
void resumeFromRecovery(int override_route_step, float custom_heading_deg) {
  setMotors(0, 0);
  if (override_route_step >= 0 && override_route_step <= 5) {
    recovery_target_index = override_route_step;
  }
  if (isfinite(custom_heading_deg)) {
    pending_recovery_heading_deg = custom_heading_deg;
  }

  if (!runHandsOffCountdown(RECOVERY_COUNTDOWN_MS, "Resuming from Missed Waypoint")) {
    return;
  }

  const Point missed = (recovery_target_index < 5)
      ? waypoints[optimal_route[recovery_target_index]]
      : Point{0.0f, 0.0f};

  x_cm = missed.x;
  y_cm = missed.y;
  theta_rad = normalizeAngle(pending_recovery_heading_deg * DEG_TO_RAD);
  syncOdometryTrackers(false);

  last_dwelled_index = recovery_target_index;
  last_dwell_end_ms = millis();
  last_dwell_pos = missed;
  current_target_index = recovery_target_index + 1;
  paused_for_recovery = false;
  pending_recovery_heading_deg = 0.0f;
  abort_current_motion = false;
  mission_started = true;

  Serial.print("\n[RECOVERY COMPLETE]: Snapped to (");
  Serial.print(x_cm, 1);
  Serial.print(", ");
  Serial.print(y_cm, 1);
  Serial.print("), Heading = ");
  Serial.print(theta_rad * RAD_TO_DEG, 1);
  Serial.println(" deg.");

  if (current_target_index > 5) {
    mission_done = true;
    setMotors(0, 0);
    Serial.println("[MISSION COMPLETE]: All targets and Home base secured!");
  } else {
    mission_done = false;
  }
}

// ==========================================
// 8. PID CONTROL LOOPS
// ==========================================
bool turnToHeading(float target_angle_rad) {
  if (!isfinite(target_angle_rad)) { setMotors(0, 0); return false; }

  target_angle_rad = normalizeAngle(target_angle_rad);
  float previous_error = normalizeAngle(target_angle_rad - theta_rad);
  float integral = 0.0f;

  const uint32_t start_time_ms = millis();
  uint32_t previous_time_us = micros() - (CONTROL_PERIOD_MS * 1000UL);
  uint32_t settled_since_ms = 0;
  uint32_t stall_since_ms = 0;
  uint32_t hard_stall_since_ms = 0;
  float stall_anchor_heading = theta_rad;

  while (static_cast<uint32_t>(millis() - start_time_ms) < CONTROL_TIMEOUT_MS) {
    if (checkUserInput()) { setMotors(0, 0); return false; }
    updateOdometry();
    printTelemetry(); 

    const uint32_t now_us = micros();
    const uint32_t elapsed_us = now_us - previous_time_us;
    if (elapsed_us == 0) { delay(1); continue; }
    // Controller time step clamped separately from odometry rate time step
    const float dt_s = fminf(fmaxf(elapsed_us / 1000000.0f, 0.001f), MAX_CONTROL_DT_S);
    previous_time_us = now_us;
    const uint32_t now_ms = millis();

    const float error = normalizeAngle(target_angle_rad - theta_rad);

    // 1. Primary tight settle check (1.7 deg AND stationary throughout 150ms window)
    if (fabsf(error) <= HEADING_TOLERANCE_RAD) {
      setMotors(0, 0);
      if (isChassisStationary(0)) {
        if (settled_since_ms == 0) settled_since_ms = now_ms;
        if (static_cast<uint32_t>(now_ms - settled_since_ms) >= PRIMARY_SETTLE_MS) return true;
      } else {
        settled_since_ms = 0;
      }
      delay(CONTROL_PERIOD_MS);
      continue;
    }
    settled_since_ms = 0;

    // 2. Practical stall-settle check (within 5 deg AND stationary throughout 600ms window)
    if (fabsf(error) <= HEADING_ACCEPTABLE_RAD && isChassisStationary(0)) {
      if (fabsf(normalizeAngle(theta_rad - stall_anchor_heading)) > 0.006f) {
        stall_anchor_heading = theta_rad;
        stall_since_ms = now_ms;
      } else if (stall_since_ms == 0) {
        stall_since_ms = now_ms;
      } else if (static_cast<uint32_t>(now_ms - stall_since_ms) >= STALL_SETTLE_MS) {
        setMotors(0, 0);
        return true;
      }
    } else {
      stall_since_ms = 0;
      stall_anchor_heading = theta_rad;
    }

    // Zero-crossing anti-windup reset
    if ((error > 0.0f && previous_error < 0.0f) || (error < 0.0f && previous_error > 0.0f)) {
      integral = 0.0f;
    }
    previous_error = error;

    integral = constrain(integral + error * dt_s, -5.0f, 5.0f);
    const float derivative = -latest_turn_rate_rad_s;
    float turn_power = Kp_turn * error + Ki_turn * integral + Kd_turn * derivative;
    turn_power = applyDeadbandWithDirection(turn_power, error, min_turn_pwm);

    // Soft-start ramp bounded by active_max so configured PWM ceiling is never exceeded
    const uint32_t elapsed_ms = static_cast<uint32_t>(now_ms - start_time_ms);
    const float active_max = fminf(255.0f, max_turn_pwm);
    const float ramp_start = fminf(80.0f, active_max);
    const float ramp_limit = (elapsed_ms < RAMP_UP_MS)
        ? (ramp_start + ((active_max - ramp_start) * static_cast<float>(elapsed_ms)) / static_cast<float>(RAMP_UP_MS))
        : active_max;
    turn_power = constrain(turn_power, -ramp_limit, ramp_limit);

    // 3. Hardware burnout protection if physically jammed for > 2.5s
    if (fabsf(turn_power) > 80.0f && isChassisStationary(40)) {
      if (hard_stall_since_ms == 0) hard_stall_since_ms = now_ms;
      else if (static_cast<uint32_t>(now_ms - hard_stall_since_ms) >= HARD_STALL_PROTECT_MS) {
        setMotors(0, 0);
        if (fabsf(error) <= 0.15f) return true; // Within ~8.5 deg: proceed to drive (which will home in)
        Serial.println("\n[STALL PROTECTION]: Chassis jammed during turn. Pausing to protect motors.");
        if (mission_started && !mission_done) enterRecoveryPause();
        return false;
      }
    } else {
      hard_stall_since_ms = 0;
    }

    setMotors(-turn_power, turn_power);
    delay(CONTROL_PERIOD_MS);
  }

  setMotors(0, 0);
  Serial.println("\n[TIMEOUT FAULT]: Turn failed to reach target heading within 30s.");
  if (mission_started && !mission_done) enterRecoveryPause();
  return false;
}

bool driveDistance(float distance_cm, float locked_heading_override, const Point *live_target) {
  if (!isfinite(distance_cm)) { setMotors(0, 0); return false; }
  if (fabsf(distance_cm) <= DISTANCE_TOLERANCE_CM) { setMotors(0, 0); return true; }

  const float start_x = x_cm;
  const float start_y = y_cm;
  float segment_heading = isfinite(locked_heading_override)
      ? normalizeAngle(locked_heading_override)
      : theta_rad;
  float previous_error = distance_cm;
  float integral = 0.0f;
  int realign_count = 0;

  const uint32_t start_time_ms = millis();
  uint32_t previous_time_us = micros() - (CONTROL_PERIOD_MS * 1000UL);
  uint32_t settled_since_ms = 0;
  uint32_t stall_since_ms = 0;
  uint32_t hard_stall_since_ms = 0;
  float stall_anchor_dist = distance_cm;

  while (static_cast<uint32_t>(millis() - start_time_ms) < CONTROL_TIMEOUT_MS) {
    if (checkUserInput()) { setMotors(0, 0); return false; }
    updateOdometry();
    printTelemetry(); 

    const uint32_t now_us = micros();
    const uint32_t elapsed_us = now_us - previous_time_us;
    if (elapsed_us == 0) { delay(1); continue; }
    // Controller time step clamped separately from odometry rate time step
    const float dt_s = fminf(fmaxf(elapsed_us / 1000000.0f, 0.001f), MAX_CONTROL_DT_S);
    previous_time_us = now_us;
    const uint32_t now_ms = millis();

    const float traveled = (x_cm - start_x) * cosf(segment_heading) + (y_cm - start_y) * sinf(segment_heading);
    const float derivative = -filtered_speed_cm_s;

    float error = distance_cm - traveled;
    float heading_error = normalizeAngle(segment_heading - theta_rad);
    float check_dist = fabsf(error);

    // Fixed-segment along/cross-track lookahead steering
    if (live_target != nullptr) {
      const float rem_dx = live_target->x - x_cm;
      const float rem_dy = live_target->y - y_cm;
      const float radius = hypotf(rem_dx, rem_dy);
      check_dist = radius;

      if (radius <= DISTANCE_TOLERANCE_CM) {
        setMotors(0, 0);
        if (isChassisStationary(0)) {
          if (settled_since_ms == 0) settled_since_ms = now_ms;
          if (static_cast<uint32_t>(now_ms - settled_since_ms) >= PRIMARY_SETTLE_MS) return true;
        } else {
          settled_since_ms = 0;
        }
        delay(CONTROL_PERIOD_MS);
        continue;
      }

      const float along = rem_dx * cosf(segment_heading) + rem_dy * sinf(segment_heading);
      const float cross = -rem_dx * sinf(segment_heading) + rem_dy * cosf(segment_heading);

      // If perpendicular line is reached: settle if within acceptable radius & stationary, else realign
      if (fabsf(along) <= DISTANCE_TOLERANCE_CM) {
        if (radius <= DISTANCE_ACCEPTABLE_CM) {
          setMotors(0, 0);
          if (isChassisStationary(0)) {
            if (settled_since_ms == 0) settled_since_ms = now_ms;
            if (static_cast<uint32_t>(now_ms - settled_since_ms) >= PRIMARY_SETTLE_MS) return true;
          } else {
            settled_since_ms = 0;
          }
          delay(CONTROL_PERIOD_MS);
          continue;
        } else if (realign_count < 2) {
          realign_count++;
          setMotors(0, 0);
          segment_heading = atan2f(rem_dy, rem_dx);
          if (!turnToHeading(segment_heading)) return false;
          previous_time_us = micros() - (CONTROL_PERIOD_MS * 1000UL);
          settled_since_ms = 0;
          stall_since_ms = 0;
          integral = 0.0f;
          continue;
        }
      }

      const float direction = (along >= 0.0f) ? 1.0f : -1.0f;
      const float lookahead_corr = constrain(
          atan2f(direction * cross, fmaxf(fabsf(along), LOOKAHEAD_CM)),
          -0.45f, 0.45f);
      heading_error = normalizeAngle(segment_heading + lookahead_corr - theta_rad);
      error = along;

      // If knocked >45 deg off-course while >8cm from waypoint, stop & realign cleanly
      if (fabsf(heading_error) > 0.8f && radius > 8.0f && realign_count < 2) {
        realign_count++;
        setMotors(0, 0);
        segment_heading = atan2f(rem_dy, rem_dx);
        if (!turnToHeading(segment_heading)) return false;
        previous_time_us = micros() - (CONTROL_PERIOD_MS * 1000UL);
        settled_since_ms = 0;
        stall_since_ms = 0;
        integral = 0.0f;
        continue;
      }
    }
    
    // 1. Primary tight settle check (0.8 cm AND stationary throughout 150ms window)
    if (fabsf(error) <= DISTANCE_TOLERANCE_CM && check_dist <= DISTANCE_ACCEPTABLE_CM) {
      setMotors(0, 0);
      if (isChassisStationary(0)) {
        if (settled_since_ms == 0) settled_since_ms = now_ms;
        if (static_cast<uint32_t>(now_ms - settled_since_ms) >= PRIMARY_SETTLE_MS) return true;
      } else {
        settled_since_ms = 0;
      }
      delay(CONTROL_PERIOD_MS);
      continue;
    }
    settled_since_ms = 0;

    // 2. Practical stall-settle check (within 2.8 cm AND stationary throughout 600ms window)
    if (check_dist <= DISTANCE_ACCEPTABLE_CM && isChassisStationary(0)) {
      if (fabsf(check_dist - stall_anchor_dist) > 0.15f) {
        stall_anchor_dist = check_dist;
        stall_since_ms = now_ms;
      } else if (stall_since_ms == 0) {
        stall_since_ms = now_ms;
      } else if (static_cast<uint32_t>(now_ms - stall_since_ms) >= STALL_SETTLE_MS) {
        setMotors(0, 0);
        return true;
      }
    } else {
      stall_since_ms = 0;
      stall_anchor_dist = check_dist;
    }

    // Zero-crossing anti-windup reset
    if ((error > 0.0f && previous_error < 0.0f) || (error < 0.0f && previous_error > 0.0f)) {
      integral = 0.0f;
    }
    previous_error = error;

    integral = constrain(integral + error * dt_s, -100.0f, 100.0f);
    float forward_power = Kp_dist * error + Ki_dist * integral + Kd_dist * derivative;
    forward_power = applyDeadbandWithDirection(forward_power, error, min_drive_pwm);

    // Apply cosine scaling AFTER friction deadband whenever pushing toward error
    if (forward_power * error > 0.0f) {
      forward_power *= fmaxf(0.0f, cosf(heading_error));
    }

    // Soft-start ramp bounded by active_max so configured PWM ceiling is never exceeded
    const uint32_t elapsed_ms = static_cast<uint32_t>(now_ms - start_time_ms);
    const float active_max = fminf(255.0f, max_drive_pwm);
    const float ramp_start = fminf(80.0f, active_max);
    const float ramp_limit = (elapsed_ms < RAMP_UP_MS)
        ? (ramp_start + ((active_max - ramp_start) * static_cast<float>(elapsed_ms)) / static_cast<float>(RAMP_UP_MS))
        : active_max;
    forward_power = constrain(forward_power, -ramp_limit, ramp_limit);

    // Full PD heading correction during straight drive
    const float correction_power = Kp_turn * heading_error - Kd_turn * latest_turn_rate_rad_s;

    float left_pwm = forward_power - correction_power;
    float right_pwm = forward_power + correction_power;
    limitMotorPair(left_pwm, right_pwm, ramp_limit);

    // 3. Hardware burnout protection if physically jammed for > 2.5s
    if (fmaxf(fabsf(left_pwm), fabsf(right_pwm)) > 80.0f && isChassisStationary(40)) {
      if (hard_stall_since_ms == 0) hard_stall_since_ms = now_ms;
      else if (static_cast<uint32_t>(now_ms - hard_stall_since_ms) >= HARD_STALL_PROTECT_MS) {
        setMotors(0, 0);
        if (check_dist <= 4.5f) return true; // Safely inside the 10cm circle (5cm radius): accept & dwell
        Serial.println("\n[STALL PROTECTION]: Chassis jammed during drive. Pausing to protect motors.");
        if (mission_started && !mission_done) enterRecoveryPause();
        return false;
      }
    } else {
      hard_stall_since_ms = 0;
    }

    setMotors(left_pwm, right_pwm);
    delay(CONTROL_PERIOD_MS);
  }

  setMotors(0, 0);
  Serial.println("\n[TIMEOUT FAULT]: Drive failed to reach target distance within 30s.");
  if (mission_started && !mission_done) enterRecoveryPause();
  return false;
}

// ==========================================
// 9. SERIAL & BUTTON INPUT HANDLING
// ==========================================
bool parseCommandFloat(const char *text, float &value) {
  if (text == nullptr || *text == '\0') return false;
  char *end = nullptr;
  value = strtof(text, &end);
  if (end == text || !isfinite(value)) return false;
  while (*end != '\0' && isspace(static_cast<unsigned char>(*end))) ++end;
  return *end == '\0';
}

bool parseCommandInt(const char *text, int &value, int min_val, int max_val) {
  if (text == nullptr || *text == '\0') return false;
  char *end = nullptr;
  const long parsed = strtol(text, &end, 10);
  if (end == text) return false;
  while (*end != '\0' && isspace(static_cast<unsigned char>(*end))) ++end;
  if (*end != '\0' || parsed < min_val || parsed > max_val) return false;
  value = static_cast<int>(parsed);
  return true;
}

bool matchCommandPrefix(const char *cmd, const char *prefix, char *&args_out) {
  const size_t len = strlen(prefix);
  if (strncmp(cmd, prefix, len) != 0) return false;
  if (cmd[len] == '\0') {
    args_out = const_cast<char *>(cmd + len);
    return true;
  }
  if (isspace(static_cast<unsigned char>(cmd[len]))) {
    char *p = const_cast<char *>(cmd + len);
    while (*p != '\0' && isspace(static_cast<unsigned char>(*p))) ++p;
    args_out = p;
    return true;
  }
  return false;
}

void handleSerialCommand(char *command) {
  while (*command != '\0' && isspace(static_cast<unsigned char>(*command))) ++command;
  char *end = command + strlen(command);
  while (end > command && isspace(static_cast<unsigned char>(end[-1]))) *--end = '\0';
  for (char *p = command; *p != '\0'; ++p) {
    *p = static_cast<char>(tolower(static_cast<unsigned char>(*p)));
  }

  if (command[0] == '\0') return;

  if (strcmp(command, "help") == 0 || strcmp(command, "?") == 0) {
    printHelp();
    return;
  }

  if (strcmp(command, "s") == 0 || strcmp(command, "run") == 0 || strcmp(command, "start") == 0) {
    if (paused_for_recovery) {
      resumeFromRecovery();
    } else {
      triggerMissionStart();
    }
    return;
  }

  if (strcmp(command, "x") == 0 || strcmp(command, "stop") == 0 || strcmp(command, "pause") == 0) {
    if (mission_started && !paused_for_recovery) {
      enterRecoveryPause();
    } else {
      setMotors(0, 0);
      abort_current_motion = true;
      Serial.println("\n[MOTORS STOPPED]");
    }
    return;
  }

  if (strcmp(command, "status") == 0) {
    printStatusReport();
    return;
  }

  if (strcmp(command, "zero") == 0) {
    if (mission_started && !mission_done && !paused_for_recovery) {
      Serial.println("\n[COMMAND ERROR]: Pause/stop the active mission before zeroing pose.");
      return;
    }
    setMotors(0, 0);
    x_cm = 0.0f;
    y_cm = 0.0f;
    theta_rad = 0.0f;
    syncOdometryTrackers(true);
    Serial.println("\n[POSE ZEROED]: (0, 0, 0 deg).");
    return;
  }

  if (strcmp(command, "cal") == 0 || strcmp(command, "prep") == 0) {
    if (mission_started && !mission_done && !paused_for_recovery) {
      Serial.println("\n[COMMAND ERROR]: Stop the active mission before calibrating.");
      return;
    }
    setMotors(0, 0);
    const bool cal_ok = calibrateGyro();
    syncOdometryTrackers(false);
    if (!cal_ok) {
      Serial.println("[COMMAND ERROR]: Gyro calibration failed. Ensure robot is stationary and retry 'cal'.");
    }
    return;
  }

  if (strcmp(command, "plan") == 0) {
    calculateOptimalRoute();
    return;
  }

  char *args = nullptr;

  // Bounded RAM PID Tuning: "gaind <kp> <ki> <kd>" or "gainh <kp> <ki> <kd>"
  if (matchCommandPrefix(command, "gaind", args) || matchCommandPrefix(command, "gainh", args)) {
    const bool is_dist_gain = (command[4] == 'd');
    char *save_ptr = nullptr;
    char *tok_p = strtok_r(args, " \t", &save_ptr);
    char *tok_i = strtok_r(nullptr, " \t", &save_ptr);
    char *tok_d = strtok_r(nullptr, " \t", &save_ptr);
    char *tok_extra = strtok_r(nullptr, " \t", &save_ptr);
    float kp, ki, kd;
    if (!tok_p || !tok_i || !tok_d || tok_extra ||
        !parseCommandFloat(tok_p, kp) ||
        !parseCommandFloat(tok_i, ki) ||
        !parseCommandFloat(tok_d, kd)) {
      Serial.println("\n[COMMAND ERROR]: Usage: gaind <kp> <ki> <kd> OR gainh <kp> <ki> <kd>");
      return;
    }
    if (kp < 0.0f || kp > MAX_PID_GAIN || ki < 0.0f || ki > MAX_PID_GAIN || kd < 0.0f || kd > MAX_PID_GAIN) {
      Serial.println("\n[COMMAND ERROR]: PID gains rejected. Each gain must be between 0.0 and 500.0.");
      return;
    }
    if (is_dist_gain) { Kp_dist = kp; Ki_dist = ki; Kd_dist = kd; }
    else              { Kp_turn = kp; Ki_turn = ki; Kd_turn = kd; }
    printStatusReport();
    return;
  }

  // Validated RAM PWM Limit Tuning: "pwm <drive_max> <turn_max>" or "minpwm <drive_min> <turn_min>"
  if (matchCommandPrefix(command, "pwm", args) || matchCommandPrefix(command, "minpwm", args)) {
    const bool is_min = (command[0] == 'm');
    char *save_ptr = nullptr;
    char *tok_d = strtok_r(args, " \t", &save_ptr);
    char *tok_t = strtok_r(nullptr, " \t", &save_ptr);
    char *tok_extra = strtok_r(nullptr, " \t", &save_ptr);
    float d_val, t_val;
    if (!tok_d || !tok_t || tok_extra || !parseCommandFloat(tok_d, d_val) || !parseCommandFloat(tok_t, t_val)) {
      Serial.println(is_min
          ? "\n[COMMAND ERROR]: Usage: minpwm <drive_min> <turn_min>"
          : "\n[COMMAND ERROR]: Usage: pwm <drive_max> <turn_max>");
      return;
    }
    if (is_min) {
      if (d_val < 0.0f || d_val > max_drive_pwm || t_val < 0.0f || t_val > max_turn_pwm || d_val > 150.0f || t_val > 150.0f) {
        Serial.println("\n[COMMAND ERROR]: minpwm rejected. Values must be in [0, 150] and <= current max PWM.");
        return;
      }
      min_drive_pwm = d_val;
      min_turn_pwm  = t_val;
    } else {
      if (d_val < 50.0f || d_val > 255.0f || t_val < 50.0f || t_val > 255.0f || d_val < min_drive_pwm || t_val < min_turn_pwm) {
        Serial.println("\n[COMMAND ERROR]: pwm rejected. Values must be in [50, 255] and >= current minpwm.");
        return;
      }
      max_drive_pwm = d_val;
      max_turn_pwm  = t_val;
    }
    printStatusReport();
    return;
  }

  // Validated RAM Wheel Trim Tuning: "trim <left_mult> <right_mult>"
  if (matchCommandPrefix(command, "trim", args)) {
    char *save_ptr = nullptr;
    char *tok_l = strtok_r(args, " \t", &save_ptr);
    char *tok_r = strtok_r(nullptr, " \t", &save_ptr);
    char *tok_extra = strtok_r(nullptr, " \t", &save_ptr);
    float l_val, r_val;
    if (!tok_l || !tok_r || tok_extra || !parseCommandFloat(tok_l, l_val) || !parseCommandFloat(tok_r, r_val)) {
      Serial.println("\n[COMMAND ERROR]: Usage: trim <left_mult> <right_mult>");
      return;
    }
    if (l_val < 0.5f || l_val > 1.5f || r_val < 0.5f || r_val > 1.5f) {
      Serial.println("\n[COMMAND ERROR]: trim rejected. Multipliers must be between 0.5 and 1.5.");
      return;
    }
    motor_l_trim = l_val;
    motor_r_trim = r_val;
    printStatusReport();
    return;
  }

  // Transactional, integer-checked, range-validated waypoint update: "wp <1..5> <x_cm> <y_cm>"
  if (matchCommandPrefix(command, "wp", args)) {
    if (mission_started && !mission_done && !paused_for_recovery) {
      Serial.println("\n[COMMAND ERROR]: Stop the active mission before editing waypoints.");
      return;
    }
    char *save_ptr = nullptr;
    char *tok_id = strtok_r(args, " \t", &save_ptr);
    char *tok_x  = strtok_r(nullptr, " \t", &save_ptr);
    char *tok_y  = strtok_r(nullptr, " \t", &save_ptr);
    char *tok_extra = strtok_r(nullptr, " \t", &save_ptr);
    int wp_id = 0;
    float wx = 0.0f, wy = 0.0f;
    if (!tok_id || !tok_x || !tok_y || tok_extra ||
        !parseCommandInt(tok_id, wp_id, 1, 5) ||
        !parseCommandFloat(tok_x, wx) ||
        !parseCommandFloat(tok_y, wy)) {
      Serial.println("\n[COMMAND ERROR]: Usage: wp <1..5> <x_cm> <y_cm> (ID must be integer 1..5).");
      return;
    }
    if (wx < MIN_COORD_CM || wx > MAX_COORD_CM || wy < MIN_COORD_CM || wy > MAX_COORD_CM) {
      Serial.println("\n[COMMAND ERROR]: Waypoint coordinates out of bounds (expected [-300, 300] cm).");
      return;
    }
    const int idx = wp_id - 1;
    const Point previous_wp = waypoints[idx];
    waypoints[idx] = {wx, wy};
    if (!calculateOptimalRoute()) {
      waypoints[idx] = previous_wp; // Transactional rollback on route failure
      Serial.println("\n[COMMAND ERROR]: Route calculation failed; waypoint change rolled back.");
      return;
    }
    Serial.print("\n[WAYPOINT COMMITTED]: P");
    Serial.print(wp_id);
    Serial.print(" = (");
    Serial.print(wx, 1);
    Serial.print(", ");
    Serial.print(wy, 1);
    Serial.println(")");
    return;
  }

  // Recovery command: "r [leg 1..6] [heading_deg]" or "resume"
  if (matchCommandPrefix(command, "r", args) || strcmp(command, "resume") == 0) {
    int override_step = -1;
    float custom_heading_deg = NAN;
    if (args != nullptr && *args != '\0') {
      char *save_ptr = nullptr;
      char *tok_step = strtok_r(args, " \t", &save_ptr);
      char *tok_hdg  = strtok_r(nullptr, " \t", &save_ptr);
      char *tok_extra = strtok_r(nullptr, " \t", &save_ptr);
      int step_int = 0;
      if (tok_extra != nullptr || !parseCommandInt(tok_step, step_int, 1, 6)) {
        Serial.println("\n[COMMAND ERROR]: Usage: r [leg 1..6] [heading_deg -360..360]");
        return;
      }
      override_step = step_int - 1;
      if (tok_hdg != nullptr) {
        float parsed_hdg = 0.0f;
        if (!parseCommandFloat(tok_hdg, parsed_hdg) || fabsf(parsed_hdg) > 360.0f) {
          Serial.println("\n[COMMAND ERROR]: Invalid recovery heading (expected finite degrees in [-360, 360]).");
          return;
        }
        custom_heading_deg = parsed_hdg;
      } else if (paused_for_recovery) {
        // If user explicitly specifies a new leg while paused without a heading token, default that leg's heading to 0 deg
        custom_heading_deg = 0.0f;
      }
    }

    if (!mission_started) {
      Serial.println("\n[COMMAND IGNORED]: Mission has not started yet.");
      return;
    }
    if (!paused_for_recovery) {
      enterRecoveryPause(override_step, isfinite(custom_heading_deg) ? custom_heading_deg : 0.0f);
    } else {
      resumeFromRecovery(override_step, custom_heading_deg);
    }
    return;
  }

  // Standalone PID test commands: "turn <deg>", "rotate <deg>", "drive <cm>"
  const bool is_turn = matchCommandPrefix(command, "turn", args);
  const bool is_rotate = !is_turn && matchCommandPrefix(command, "rotate", args);
  const bool is_drive = !is_turn && !is_rotate && matchCommandPrefix(command, "drive", args);
  if (is_turn || is_rotate || is_drive) {
    float value = 0.0f;
    if (!parseCommandFloat(args, value) || ((is_turn || is_rotate) && fabsf(value) > 360.0f) || (is_drive && fabsf(value) > 400.0f)) {
      Serial.println("\n[COMMAND ERROR]: Expected a single valid numeric value (angle in [-360, 360] or distance in [-400, 400] cm).");
      return;
    }
    if (mission_started && !mission_done && !paused_for_recovery) {
      Serial.println("\n[COMMAND ERROR]: Pause/stop the active mission before a PID test.");
      return;
    }

    abort_current_motion = false;
    if (!is_rotate) {
      x_cm = 0.0f;
      y_cm = 0.0f;
      theta_rad = 0.0f;
    }
    syncOdometryTrackers(false);

    const float target_rad = is_rotate
        ? normalizeAngle(theta_rad + value * DEG_TO_RAD)
        : (value * DEG_TO_RAD);
    const bool succeeded = (is_turn || is_rotate)
        ? turnToHeading(target_rad)
        : driveDistance(value, theta_rad, nullptr);
    setMotors(0, 0);
    abort_current_motion = false;
    Serial.println(succeeded ? "\n[PID TEST COMPLETE]" : "\n[PID TEST FAILED OR STOPPED]");
    return;
  }

  Serial.println("\n[COMMAND ERROR]: Unknown command. Type 'help' for available commands.");
}

// Unified input monitor for both Serial text and the physical BOOT button
bool checkUserInput() {
  static uint32_t last_press_ms = 0;
  const bool curr_btn = digitalRead(BTN_PIN);
  
  if (curr_btn == LOW && last_btn_state == HIGH && static_cast<uint32_t>(millis() - last_press_ms) > 300) {
    last_press_ms = millis();
    last_btn_state = LOW;

    if (!mission_started) {
      triggerMissionStart();
    } else if (!paused_for_recovery) {
      enterRecoveryPause();
    } else {
      // Paused -> Short tap (<0.8s) starts 5s recovery countdown; Hold (>=0.8s) cycles recovery leg
      const uint32_t hold_start_ms = millis();
      bool cycled_selection = false;
      while (digitalRead(BTN_PIN) == LOW) {
        if (static_cast<uint32_t>(millis() - hold_start_ms) >= 800) {
          cycled_selection = true;
          const int max_leg = constrain(current_target_index, 0, 5);
          recovery_target_index = (recovery_target_index > 0) ? (recovery_target_index - 1) : max_leg;
          recovery_blink_start_ms = millis();
          Serial.print("\n[BUTTON SELECTION]: Cycled recovery target to Route Leg ");
          Serial.print(recovery_target_index + 1);
          if (recovery_target_index < 5) {
            Serial.print(" (Waypoint P");
            Serial.print(optimal_route[recovery_target_index] + 1);
            Serial.println(")");
          } else {
            Serial.println(" (HOME)");
          }
          for (int k = 0; k < 2; ++k) {
            digitalWrite(LED_PIN, HIGH); delay(80);
            digitalWrite(LED_PIN, LOW);  delay(80);
          }
          while (digitalRead(BTN_PIN) == LOW) delay(10);
          break;
        }
        delay(10);
      }
      if (!cycled_selection) {
        resumeFromRecovery();
      }
    }
    last_btn_state = digitalRead(BTN_PIN);
    return abort_current_motion;
  }
  last_btn_state = curr_btn;

  while (Serial.available() > 0) {
    const char input = static_cast<char>(Serial.read());
    if ((input == 'x' || input == 'X') && serial_command_length == 0) {
      if (mission_started && !paused_for_recovery) {
        enterRecoveryPause();
      } else {
        setMotors(0, 0);
        abort_current_motion = true;
      }
      serial_command_length = 0;
      serial_command_overflow = false;
      return abort_current_motion;
    }
    if (input == '\r') continue;
    if (input == '\n') {
      if (!serial_command_overflow) {
        serial_command[serial_command_length] = '\0';
        handleSerialCommand(serial_command);
      } else {
        Serial.println("\n[COMMAND ERROR]: Input line is too long.");
      }
      serial_command_length = 0;
      serial_command_overflow = false;
      if (abort_current_motion) break;
    } else if (!serial_command_overflow) {
      if (serial_command_length + 1 < sizeof(serial_command)) {
        serial_command[serial_command_length++] = input;
      } else {
        serial_command_overflow = true;
      }
    }
  }
  return abort_current_motion;
}

// ==========================================
// 10. SETUP & MAIN MISSION CONTROL LOOP
// ==========================================
void setup() {
  Serial.begin(115200);
  
  pinMode(BTN_PIN, INPUT_PULLUP);
  pinMode(LED_PIN, OUTPUT);
  digitalWrite(LED_PIN, LOW);
  
  setupMotors();
  
  pinMode(ENC_L_A, INPUT_PULLUP); pinMode(ENC_L_B, INPUT_PULLUP);
  pinMode(ENC_R_A, INPUT_PULLUP); pinMode(ENC_R_B, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(ENC_L_A), isr_left, RISING);
  attachInterrupt(digitalPinToInterrupt(ENC_R_A), isr_right, RISING);

  while (!setupIMU()) {
    Serial.println("[INIT ERROR]: Failed to initialize MPU-6050. Check SDA(21)/SCL(22) wiring...");
    digitalWrite(LED_PIN, HIGH); delay(100);
    digitalWrite(LED_PIN, LOW);  delay(900);
  }
  while (!calibrateGyro()) {
    Serial.println("[INIT ERROR]: Gyro calibration failed. Place robot on a flat, still surface...");
    delay(500);
  }
  
  if (!calculateOptimalRoute()) {
    setMotors(0, 0);
    while (true) delay(1000);
  }
  syncOdometryTrackers(true);
  last_btn_state = digitalRead(BTN_PIN);
  Serial.println("READY: Place robot at Origin (0,0) facing +X and press BOOT button (or send 's').");
}

void loop() {
  checkUserInput();
  updateOdometry();
  printTelemetry();

  if (!mission_started || mission_done || paused_for_recovery) {
    setMotors(0, 0);
    if (paused_for_recovery) {
      // Diagnostic LED pulse pattern: blinks waypoint ID (1..5, or 6 for Home)
      const uint32_t pulses = (recovery_target_index < 5)
          ? static_cast<uint32_t>(optimal_route[recovery_target_index] + 1)
          : 6UL;
      const uint32_t phase = static_cast<uint32_t>(millis() - recovery_blink_start_ms) % (pulses * 400UL + 1600UL);
      digitalWrite(LED_PIN, (phase < pulses * 400UL && (phase % 400UL) < 180UL) ? HIGH : LOW);
    }
    delay(CONTROL_PERIOD_MS);
    return;
  }

  abort_current_motion = false;
  Point target;
  if (current_target_index < 5) {
    target = waypoints[optimal_route[current_target_index]];
    Serial.print("\n--- Heading to Waypoint "); 
    Serial.print(current_target_index + 1); 
    Serial.print("/5 (P");
    Serial.print(optimal_route[current_target_index] + 1);
    Serial.println(") ---");
  } else {
    target = {0.0f, 0.0f}; 
    Serial.println("\n--- Returning HOME ---");
  }

  float dx = target.x - x_cm;
  float dy = target.y - y_cm;
  
  if (hypotf(dx, dy) > DISTANCE_TOLERANCE_CM) {
    Serial.println("1. Turning to face target...");
    if (!turnToHeading(atan2f(dy, dx))) {
      setMotors(0, 0);
      return; // Paused for recovery or stopped by user
    }
  }

  dx = target.x - x_cm;
  dy = target.y - y_cm;
  const float target_distance = hypotf(dx, dy);
  const float exact_target_heading = atan2f(dy, dx);
  
  Serial.println("2. Driving straight to target...");
  if (!driveDistance(target_distance, exact_target_heading, &target)) {
    setMotors(0, 0);
    return; // Paused for recovery or stopped by user
  }

  // Wait up to 400ms for physical coasting to stop completely before starting the 2.5s judge dwell clock
  setMotors(0, 0);
  const uint32_t brake_wait_start = millis();
  while (!isChassisStationary(STILL_HOLD_MS) && static_cast<uint32_t>(millis() - brake_wait_start) < 400) {
    if (checkUserInput()) { setMotors(0, 0); return; }
    updateOdometry();
    delay(CONTROL_PERIOD_MS);
  }

  // Post-coasting Dwell Guard: if robot coasted >3.2cm past target, perform one precision trim
  const float post_coast_dx = target.x - x_cm;
  const float post_coast_dy = target.y - y_cm;
  const float post_coast_dist = hypotf(post_coast_dx, post_coast_dy);
  if (post_coast_dist > 3.2f) {
    if (!driveDistance(post_coast_dist, atan2f(post_coast_dy, post_coast_dx), &target)) {
      setMotors(0, 0);
      return;
    }
    setMotors(0, 0);
  }

  Serial.println("3. Target Reached & Stationary! Dwelling for 2.5s...");
  in_dwell_phase = true;
  digitalWrite(LED_PIN, HIGH); // Visual stop indicator for judges
  
  const uint32_t dwell_start = millis();
  while (static_cast<uint32_t>(millis() - dwell_start) < 2500) {
    if (checkUserInput()) {
      setMotors(0, 0);
      digitalWrite(LED_PIN, LOW);
      in_dwell_phase = false;
      return; // Paused for recovery or stopped by user
    }
    
    updateOdometry();
    printTelemetry();
    delay(CONTROL_PERIOD_MS);
  }
  
  digitalWrite(LED_PIN, LOW);
  in_dwell_phase = false;

  // Record completed dwell state so post-dwell recovery within 8s/25cm still snaps to THIS waypoint
  last_dwelled_index = current_target_index;
  last_dwell_end_ms = millis();
  last_dwell_pos = {x_cm, y_cm};

  current_target_index++;
  
  if (current_target_index > 5) {
    mission_done = true;
    setMotors(0, 0);
    Serial.println("\n[MISSION COMPLETE]: All targets and Home base secured!");
  }
}
