void IRAM_ATTR isr_left() {
  const int32_t delta = (digitalRead(ENC_L_B) == HIGH ? 1 : -1) * ENC_L_SIGN;
  portENTER_CRITICAL_ISR(&encoder_mux);
  ticks_L += delta;
  portEXIT_CRITICAL_ISR(&encoder_mux);
}

void IRAM_ATTR isr_right() {
  const int32_t delta = (digitalRead(ENC_R_B) == LOW ? 1 : -1) * ENC_R_SIGN;
  portENTER_CRITICAL_ISR(&encoder_mux);
  ticks_R += delta;
  portEXIT_CRITICAL_ISR(&encoder_mux);
}

void takeEncoderSnapshot(int32_t &out_L, int32_t &out_R) {
  portENTER_CRITICAL(&encoder_mux);
  out_L = ticks_L;
  out_R = ticks_R;
  portEXIT_CRITICAL(&encoder_mux);
}

void syncOdometryTrackers(bool zero_hardware_ticks = false) {
  portENTER_CRITICAL(&encoder_mux);
  if (zero_hardware_ticks) {
    ticks_L = 0;
    ticks_R = 0;
  }
  last_ticks_L = ticks_L;
  last_ticks_R = ticks_R;
  portEXIT_CRITICAL(&encoder_mux);
  filtered_speed_cm_s = 0.0f;
  latest_gyro_deg_s = 0.0f;
  latest_turn_rate_rad_s = 0.0f;
  still_since_ms = millis();
  last_time_us = micros();
}

bool writeIMURegister(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  return Wire.endTransmission(true) == 0;
}

bool readIMURegister(uint8_t reg, uint8_t &value) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  if (Wire.endTransmission(false) != 0 || Wire.requestFrom(MPU_ADDR, 1, true) != 1) return false;
  const int b = Wire.read();
  if (b < 0) return false;
  value = static_cast<uint8_t>(b);
  return true;
}

bool configureIMURegisters() {
  // 0x1A = 0x03 (42Hz Hardware DLPF), 0x19 = 0x09 (100Hz Sample Rate), 0x1B = 0x08 (+/-500 deg/s)
  return writeIMURegister(0x1A, 0x03) &&
         writeIMURegister(0x19, 0x09) &&
         writeIMURegister(0x1B, 0x08);
}

bool setupIMU() {
  if (!Wire.begin(I2C_SDA, I2C_SCL)) return false;
  Wire.setClock(400000);
  Wire.setTimeOut(4); // Short 4ms timeout prevents I2C bus glitches from stalling PID loop

  uint8_t who_am_i = 0;
  if (!readIMURegister(0x75, who_am_i) || ((who_am_i & 0x7E) != 0x68 && who_am_i != 0x70)) {
    return false;
  }

  // 0x6B = 0x01 (Wake up + lock clock to X-axis gyro PLL for thermal stability)
  if (!writeIMURegister(0x6B, 0x01)) return false;
  delay(50);
  imu_recovery_pending = false;
  return configureIMURegisters();
}

bool readGyroRaw(int16_t &raw_z) {
  for (int attempt = 0; attempt < 2; ++attempt) {
    Wire.beginTransmission(MPU_ADDR);
    Wire.write(0x47);
    if (Wire.endTransmission(false) == 0 && Wire.requestFrom(MPU_ADDR, 2, true) == 2) {
      const int high_byte = Wire.read();
      const int low_byte = Wire.read();
      if (high_byte >= 0 && low_byte >= 0) {
        const uint16_t combined = (static_cast<uint16_t>(high_byte) << 8) | static_cast<uint16_t>(low_byte);
        const int16_t val = static_cast<int16_t>(combined);
        // Reject saturated / all-1s corrupted I2C reads so encoder fallback handles the tick
        if (val >= 32700 || val <= -32700) return false;
        raw_z = val;
        return true;
      }
    }
    delayMicroseconds(30);
  }
  return false;
}

// Strict stationary gyro calibration (returns false if robot moved or noise remained high)
bool calibrateGyro(uint16_t samples = 500, uint16_t settle_ms = 500) {
  gyro_calibrated = false;
  if (settle_ms > 0) delay(settle_ms);

  for (int cal_attempt = 0; cal_attempt < 5; ++cal_attempt) {
    int32_t start_L, start_R;
    takeEncoderSnapshot(start_L, start_R);

    double sum = 0.0;
    double sum_sq = 0.0;
    bool read_ok = true;
    for (uint16_t i = 0; i < samples; i++) {
      int16_t raw_z;
      if (!readGyroRaw(raw_z)) {
        read_ok = false;
        break;
      }
      const double deg_s = (static_cast<double>(raw_z) / 65.5) * static_cast<double>(GYRO_Z_SIGN);
      sum += deg_s;
      sum_sq += deg_s * deg_s;
      if (i % 40 == 0) digitalWrite(LED_PIN, !digitalRead(LED_PIN));
      delay(2);
    }
    digitalWrite(LED_PIN, LOW);

    if (!read_ok) {
      Serial.println("[CAL WARNING]: I2C read failed during calibration; retrying...");
      delay(250);
      continue;
    }

    int32_t end_L, end_R;
    takeEncoderSnapshot(end_L, end_R);

    const double mean = sum / static_cast<double>(samples);
    const double variance = fmax(0.0, (sum_sq / static_cast<double>(samples)) - (mean * mean));
    const double sd = sqrt(variance);

    // Require strict stillness (<= 1 tick movement) and low gyro noise (< 1.2 deg/s SD)
    if (abs(end_L - start_L) <= 1 && abs(end_R - start_R) <= 1 && sd < 1.2 && fabs(mean) < 25.0) {
      gyro_z_bias = static_cast<float>(mean);
      gyro_calibrated = true;
      Serial.print("[CAL OK]: Gyro Bias = ");
      Serial.print(gyro_z_bias, 3);
      Serial.print(" deg/s | Noise SD = ");
      Serial.print(sd, 3);
      Serial.println(" deg/s");
      return true;
    }

    Serial.println("[CAL RETRY]: Chassis movement or noise detected; keep robot completely still...");
    delay(300);
  }

  Serial.println("[CAL FAILED]: Could not obtain a stationary low-noise calibration window.");
  return false;
}

bool readGyroZ(float &gyro_z) {
  int16_t raw_z;
  if (!readGyroRaw(raw_z)) return false;
  gyro_z = (static_cast<float>(raw_z) / 65.5f) * GYRO_Z_SIGN - gyro_z_bias;
  return true;
}

float normalizeAngle(float angle_rad) {
  return atan2f(sinf(angle_rad), cosf(angle_rad));
}

// Continuous sliding-window stillness check (min_quiet_ms = 0 checks instantaneous low speed & gyro rate)
bool isChassisStationary(uint32_t min_quiet_ms = STILL_HOLD_MS) {
  if (still_since_ms == 0) return false;
  if (min_quiet_ms == 0) return true;
  return static_cast<uint32_t>(millis() - still_since_ms) >= min_quiet_ms;
}

bool updateOdometry() {
  const uint32_t prof_start_us = micros();
  int32_t current_ticks_L, current_ticks_R;
  takeEncoderSnapshot(current_ticks_L, current_ticks_R);

  const uint32_t now_us = micros();
  const uint32_t elapsed_us = now_us - last_time_us;
  if (elapsed_us == 0) return true;
  last_time_us = now_us;

  // Use actual elapsed time for all rate calculations to prevent spikes after delayed iterations
  const float raw_dt_s = elapsed_us / 1000000.0f;
  const float actual_dt_s = fmaxf(raw_dt_s, 0.0005f);
  const bool dt_overrun = (raw_dt_s > MAX_CONTROL_DT_S);

  const int32_t delta_ticks_L = current_ticks_L - last_ticks_L;
  const int32_t delta_ticks_R = current_ticks_R - last_ticks_R;
  last_ticks_L = current_ticks_L;
  last_ticks_R = current_ticks_R;

  // Clamp single-tick displacement to physically plausible ceiling over actual_dt_s
  const float max_step_cm = MAX_WHEEL_SPEED_CM_S * actual_dt_s;
  const float distance_L = constrain(delta_ticks_L * CM_PER_TICK, -max_step_cm, max_step_cm);
  const float distance_R = constrain(delta_ticks_R * CM_PER_TICK, -max_step_cm, max_step_cm);
  const float distance_cm = (distance_L + distance_R) * 0.5f;
  const float encoder_delta_heading = (distance_R - distance_L) / TRACK_WIDTH_CM;

  // Low-pass filtered linear speed using actual elapsed time
  const float instant_speed_cm_s = distance_cm / actual_dt_s;
  filtered_speed_cm_s += 0.25f * (instant_speed_cm_s - filtered_speed_cm_s);

  // Non-blocking 2-step IMU recovery completion check (0ms blocking delay)
  if (imu_recovery_pending && static_cast<uint32_t>(millis() - imu_recovery_wake_ms) >= 50) {
    configureIMURegisters();
    imu_recovery_pending = false;
  }

  float gyro_z_deg_s = 0.0f;
  float delta_heading = 0.0f;
  if (!imu_recovery_pending && readGyroZ(gyro_z_deg_s)) {
    consecutive_imu_failures = 0;
    latest_gyro_deg_s = gyro_z_deg_s;
    if (!dt_overrun) {
      const float gyro_delta_heading = gyro_z_deg_s * DEG_TO_RAD * actual_dt_s;
      delta_heading = GYRO_FUSION_WEIGHT * gyro_delta_heading +
                      (1.0f - GYRO_FUSION_WEIGHT) * encoder_delta_heading;
      latest_turn_rate_rad_s = delta_heading / actual_dt_s;
    } else {
      // If loop was delayed > 100ms, integrate displacement from encoders and use live gyro for instantaneous rate
      delta_heading = encoder_delta_heading;
      latest_turn_rate_rad_s = gyro_z_deg_s * DEG_TO_RAD;
    }
  } else {
    // 100% Differential-drive wheel encoder fallback if I2C experiences motor EMI glitch
    consecutive_imu_failures++;
    if (consecutive_imu_failures % 50 == 0 && !imu_recovery_pending) {
      // Step 1 of non-blocking IMU recovery: send wake/PLL command and wait 50ms across normal ticks
      if (writeIMURegister(0x6B, 0x01)) {
        imu_recovery_wake_ms = millis();
        imu_recovery_pending = true;
      }
    }
    delta_heading = encoder_delta_heading;
    latest_turn_rate_rad_s = delta_heading / actual_dt_s;
    latest_gyro_deg_s = latest_turn_rate_rad_s * RAD_TO_DEG;
  }

  // Update continuous stillness window tracker
  if (fabsf(filtered_speed_cm_s) < STILL_SPEED_CM_S && fabsf(latest_gyro_deg_s) < STILL_GYRO_DEG_S) {
    if (still_since_ms == 0) still_since_ms = millis();
  } else {
    still_since_ms = 0;
  }

  const float midpoint_heading = theta_rad + delta_heading * 0.5f;
  x_cm += distance_cm * cosf(midpoint_heading);
  y_cm += distance_cm * sinf(midpoint_heading);
  theta_rad = normalizeAngle(theta_rad + delta_heading);

  last_loop_exec_us = micros() - prof_start_us;
  if (last_loop_exec_us > max_loop_exec_us) max_loop_exec_us = last_loop_exec_us;
  return true;
}

// ==========================================
// 5. TURN-AWARE TSP SOLVER (PHYSICAL TIME/COST MODEL)
// ==========================================
float getDistance(Point a, Point b) {
  return hypotf(a.x - b.x, a.y - b.y);
}

bool calculateOptimalRoute() {
  Serial.println("Calculating Turn-Aware TSP route...");

  for (int i = 0; i < 5; ++i) {
    if (!isfinite(waypoints[i].x) || !isfinite(waypoints[i].y) ||
        waypoints[i].x < MIN_COORD_CM || waypoints[i].x > MAX_COORD_CM ||
        waypoints[i].y < MIN_COORD_CM || waypoints[i].y > MAX_COORD_CM) {
      Serial.println("[ROUTE ERROR]: Waypoint coordinates must be finite and within [-300, 300] cm.");
      return false;
    }
  }
  
  int current_route[5] = {0, 1, 2, 3, 4}; 
  int best_route[5] = {0, 1, 2, 3, 4};
  float shortest_cost_cm = INFINITY;
  float best_est_time_s = INFINITY;
  Point origin = {0.0f, 0.0f};

  do {
    float route_cost_cm = 0.0f;
    float route_time_s = 0.0f;
    Point current_pos = origin;
    float simulated_heading = 0.0f; 

    for (int i = 0; i < 5; i++) {
      const float dx = waypoints[current_route[i]].x - current_pos.x;
      const float dy = waypoints[current_route[i]].y - current_pos.y;
      const float dist = hypotf(dx, dy);
      const float target_heading = atan2f(dy, dx);
      const float turn_amount = fabsf(normalizeAngle(target_heading - simulated_heading));
      
      route_cost_cm += dist + (turn_amount * turn_penalty_cm_per_rad);
      route_time_s  += (dist / NOMINAL_DRIVE_SPEED_CM_S) +
                       (turn_amount / NOMINAL_TURN_RATE_RAD_S) +
                       TURN_SETTLE_OVERHEAD_S;
      
      current_pos = waypoints[current_route[i]];
      simulated_heading = target_heading;
    }
    
    const float dx_home = origin.x - current_pos.x;
    const float dy_home = origin.y - current_pos.y;
    const float dist_home = hypotf(dx_home, dy_home);
    const float target_heading_home = atan2f(dy_home, dx_home);
    const float turn_amount_home = fabsf(normalizeAngle(target_heading_home - simulated_heading));

    route_cost_cm += dist_home + (turn_amount_home * turn_penalty_cm_per_rad);
    route_time_s  += (dist_home / NOMINAL_DRIVE_SPEED_CM_S) +
                     (turn_amount_home / NOMINAL_TURN_RATE_RAD_S) +
                     TURN_SETTLE_OVERHEAD_S;

    if (isfinite(route_cost_cm) && route_cost_cm < shortest_cost_cm) {
      shortest_cost_cm = route_cost_cm;
      best_est_time_s = route_time_s;
      for (int i = 0; i < 5; i++) best_route[i] = current_route[i];
    }
  } while (std::next_permutation(current_route, current_route + 5));

  if (!isfinite(shortest_cost_cm)) {
    Serial.println("[ROUTE ERROR]: No finite route could be calculated.");
    return false;
  }

  for (int i = 0; i < 5; i++) optimal_route[i] = best_route[i];

  Serial.print("Optimal Route Found! Cost: ");
  Serial.print(shortest_cost_cm, 1);
  Serial.print(" cm (Est. Motion Time: ");
  Serial.print(best_est_time_s, 1);
  Serial.print(" s) | Order: ");
  for (int i = 0; i < 5; i++) {
    Serial.print("P");
    Serial.print(optimal_route[i] + 1);
    Serial.print("[id=");
    Serial.print(optimal_route[i]);
    Serial.print("] -> ");
  }
  Serial.println("HOME");
  return true;
}

