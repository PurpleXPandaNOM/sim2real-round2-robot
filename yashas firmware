void setupMotors() {
  pinMode(MOT_L_F, OUTPUT); pinMode(MOT_L_R, OUTPUT);
  pinMode(MOT_R_F, OUTPUT); pinMode(MOT_R_R, OUTPUT);
  
  analogWrite(MOT_L_F, 0); analogWrite(MOT_L_R, 0);
  analogWrite(MOT_R_F, 0); analogWrite(MOT_R_R, 0);
}

// Only boosts PWM above static friction when pushing in the direction of the error (prevents D-term braking chatter)
float applyDeadbandWithDirection(float pwm, float error, float min_pwm) {
  if (pwm == 0.0f || min_pwm <= 0.0f) return pwm;
  if ((pwm > 0.0f && error > 0.0f) || (pwm < 0.0f && error < 0.0f)) {
    if (fabsf(pwm) < min_pwm) {
      return (pwm > 0.0f) ? min_pwm : -min_pwm;
    }
  }
  return pwm;
}

void limitMotorPair(float &left_pwm, float &right_pwm, float max_magnitude) {
  const float largest_magnitude = fmaxf(fabsf(left_pwm), fabsf(right_pwm));
  if (largest_magnitude > max_magnitude && largest_magnitude > 0.0f) {
    const float scale = max_magnitude / largest_magnitude;
    left_pwm *= scale;
    right_pwm *= scale;
  }
}

void setMotors(float left_pwm, float right_pwm) {
  if (!isfinite(left_pwm)) left_pwm = 0.0f;
  if (!isfinite(right_pwm)) right_pwm = 0.0f;

  // Instant stop if 0,0 is requested; otherwise apply gentle slew limit (max 65 PWM/tick) to protect N20 gears
  if (left_pwm == 0.0f && right_pwm == 0.0f) {
    last_cmd_left_pwm = 0.0f;
    last_cmd_right_pwm = 0.0f;
  } else {
    const float max_step = 65.0f;
    left_pwm  = constrain(left_pwm,  last_cmd_left_pwm  - max_step, last_cmd_left_pwm  + max_step);
    right_pwm = constrain(right_pwm, last_cmd_right_pwm - max_step, last_cmd_right_pwm + max_step);
    last_cmd_left_pwm = left_pwm;
    last_cmd_right_pwm = right_pwm;
  }

  left_pwm  = constrain(left_pwm  * motor_l_trim * MOTOR_L_SIGN, -255.0f, 255.0f);
  right_pwm = constrain(right_pwm * motor_r_trim * MOTOR_R_SIGN, -255.0f, 255.0f);
  const int left_output = static_cast<int>(lroundf(left_pwm));
  const int right_output = static_cast<int>(lroundf(right_pwm));

  // Clear inactive H-bridge direction FIRST to prevent simultaneous non-zero shoot-through
  if (left_output >= 0) {
    analogWrite(MOT_L_R, 0);
    analogWrite(MOT_L_F, left_output);
  } else {
    analogWrite(MOT_L_F, 0);
    analogWrite(MOT_L_R, -left_output);
  }

  if (right_output >= 0) {
    analogWrite(MOT_R_R, 0);
    analogWrite(MOT_R_F, right_output);
  } else {
    analogWrite(MOT_R_F, 0);
    analogWrite(MOT_R_R, -right_output);
  }
}

