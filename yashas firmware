  const uint32_t now = millis();
  if (now - last_telemetry_ms >= 100) { 
    last_telemetry_ms = now;
    // Non-blocking check so Serial output never stalls the 100Hz PID control loop
    if (Serial.availableForWrite() < 64) return;

    int32_t current_ticks_L, current_ticks_R;
    takeEncoderSnapshot(current_ticks_L, current_ticks_R);
    
    Serial.print(now / 1000.0f, 2); Serial.print(",");
